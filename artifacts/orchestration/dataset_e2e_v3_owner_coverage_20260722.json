  "requirements": [
    {
      "id": "reuse_validated_evidence",
      "requirement": "Preserve and reuse validated source artifacts and accepted revisions; never replay valid work merely to conform to this contract."
    },
    {
      "id": "measured_chunk_decision",
      "requirement": "Inspect the current physical layout and either record a measured no-op or recompact materially inefficient layouts with exact full-matrix/OBS parity, rollback identity, and ordinary-loader readback."
    },
    {
      "id": "dataset_shared_var",
      "requirement": "Use one dataset-level VAR across chunks/members when axes are identical and prove every X-axis link; document and independently review genuine axis exceptions."
    },
    {
      "id": "species_correct_ens_id",
      "requirement": "Use species-correct Ensembl stable IDs with exact feature count, order, and X-axis parity; preserve unresolved source values with explicit mapping evidence."
    },
    {
      "id": "source_exhaustive_obs",
      "requirement": "Inspect paper, repository records, supplements, and durable documentation; materialize every defensible row-level canonical OBS value through proven joins and preserve unknown/not_applicable with search evidence."
    },
    {
      "id": "canonical_collection_membership",
      "requirement": "Ensure resulting triplets/chunks are members of the canonical versioned Lamin Collection on laminlabs/pertdata/jkobject with append-only exact identities, duplicate/drift checks, and readback."
    },
    {
      "id": "bounded_execution_and_replay",
      "requirement": "Run heavy work on the EU VM through the bounded launcher with one writer, then prove immutable readback, replay no-op, zero unrelated drift, and zero residual writer/lease."
    },
    {
      "id": "independent_reviewer",
      "requirement": "Stop review-required; exactly one independent reviewer validates the immutable revision/live state and owns closure. Only reviewer PASS increments the strict completed-dataset numerator."
    }
  ],
