!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX14194758
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM5901nnn/GSM5901231/suppl/GSM5901231_MUC13083.tar.gz
