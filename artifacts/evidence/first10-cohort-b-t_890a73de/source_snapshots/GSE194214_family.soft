^SAMPLE = GSM5830919
!Sample_title = Somitoid Day 1
!Sample_geo_accession = GSM5830919
!Sample_status = Public on Jan 26 2022
!Sample_submission_date = Jan 23 2022
!Sample_last_update_date = Jan 28 2022
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = NCRM1 human IPSC
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell type: Human iPSC in vitro cultures
!Sample_characteristics_ch1 = developmental stage: Day 1
!Sample_characteristics_ch1 = genotype: wild type
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = Cell dissociation protocols were optimized to achieve single cell suspensions with >90% viable cells and low number of doublets. Organoids collected at day 1, 2, 3, and 5 of our differentiation protocol were pooled in pre-warmed PBS, transferred to pre-warmed accutase and incubated for 5-7 min at 37°C. For Day 1 organoid cell suspension, 30 organoids were pooled. For Day 2 organoid cell suspension, 15 organoids were pooled. For Day 3 cell suspension, 8 organoids were pooled. For Day 5 cell suspension, 5 organoids were pooled. Organoids were briefly rinsed in PBS, then transferred to 500 µl PBS/0.05% BSA and carefully triturated to generate a single-cell suspension. Cell suspension was run through a cell strainer (Falcon, cat. no. 352235) and transferred to a 1.5 ml tube. Cells were spun down at 250g for 3 min at 4°C. Cell pellet was resuspended in 25 µl PBS/0.05% BSA, cell concentration and viability was measured using an automated cell counter, and cell suspension was further diluted as appropriate to reach the optimal range for 10x (700-1200 cells per µl).
!Sample_extract_protocol_ch1 = Cells were subjected to single-cell RNA sequencing (10x Genomics, Chromium Single Cell 3’ v3) aiming for the following target cell numbers: Day 1, 3,000 cells; Day 2, 4,000 cells; Day 3, 5,000 cells; Day 5, 6,000 cells. Estimated actual cell numbers collected were: Day 1, 2,930 cells; Day 2, 4,977; Day 3, 5,968 cells; Day 5, 4,841 cells. Single-cell libraries were generated using standard protocols. Libraries were sequenced together on a NovaSeq 6000 system resulting in 800 million reads.
!Sample_description = Single-cell RNA-seq (10x)
!Sample_data_processing = Raw reads were demultiplexed, filtered and mapped to the human reference genome (GRCh38) using Cell Ranger 4.0.0 with default settings. The filtered feature-barcode matrices generated by Cell Ranger were used for further analysis.
!Sample_data_processing = For the initial QC, we determined the following thresholds for filtering out low-quality cells: UMI counts less than 500, gene counts less than 200, mitochondrial fraction above 0.2 and a complexity score of less than 0.8 (calculated as log10(genes)/log10(UMIs)).
!Sample_data_processing = Genome_build: GRCh38
!Sample_data_processing = Supplementary_files_format_and_content: Matrix table with filtered UMI counts, containing only detected cell-associated barcodes (number of UMIs associated with a feature (row) and a barcode (column)); TSV files contain gene (feature) and cell (barcode) annotations, respectively.
!Sample_platform_id = GPL24676
!Sample_contact_name = Christoph,,Budjan
!Sample_contact_email = cbudjan@gmail.com
!Sample_contact_laboratory = Hormoz Lab
!Sample_contact_department = Data Sciences
