# Python/runtime caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Local virtualenvs / optional model envs
.venv/
.venv-*/
.venv.*
.venv-models/

# Repo-local Lamin/GCS/cache state; durable data belongs in LaminDB or GCS, not Git
.lamin-*/
.lamin-cache*/
data/main/*
!data/main/.gitkeep
data/gcs_cache/
data/source_cache/
data/temporal_pretraining_sources/

# Local tooling/runtime state
.omx/
.r-lib/
.worktrees/

# Generated artifacts, reports, documentation builds, and local model-ready exports
artifacts/
logs/
site/
coverage.xml
pert-gym/model-ready-*/

# Broken Git metadata backups kept only for forensic recovery
.git.broken-*/

# Accidental shell/package-manager droppings
=*
.DS_Store
